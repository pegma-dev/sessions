{
  "name": "sessions",
  "version": "0.1.1",
  "private": true,
  "description": "Server-side session records for Pegma components.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "release:registry:check": "node scripts/release-packages.mjs registry-check",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.1",
    "@pegma/storage-azure-tables": "0.3.0",
    "@types/node": "^26.1.1",
    "azurite": "^3.36.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
